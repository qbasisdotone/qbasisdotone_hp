---
import { Code } from "astro:components";
import { code, site, t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale).hero;
---

<section class="hero">
  <div class="container hero__text">
    <h1 class="hero__title">
      <span>{copy.titleLine1}</span>
      <span class="hero__accent">{copy.titleLine2}</span>
    </h1>
    <p class="hero__sub">{copy.sub}</p>
    <div class="hero__ctas">
      <a class="btn btn--secondary btn--lg" href="#dsl">{copy.secondary}</a>
      <a class="btn btn--primary btn--lg" href={`mailto:${site.contactEmail}`}>{copy.primary}</a>
    </div>
  </div>

  <div class="container hero__stage">
    <div class="hero__grid hero__grid--a graph" aria-hidden="true"></div>
    <div class="hero__grid hero__grid--b graph graph--cyan" aria-hidden="true"></div>

    <div class="code-window hero__code">
      <div class="code-window__bar">
        <span class="code-window__dots"><span></span><span></span><span></span></span>
        {copy.codeFile}
      </div>
      <Code code={code(locale).hero.trimEnd()} lang="python" theme="css-variables" />
    </div>

    <div class="hero__output" role="group" aria-label={copy.outputTitle}>
      <div class="hero__output-head">
        <span class="qb-ket">|ψ⟩</span>
        {copy.outputTitle}
      </div>
      <dl>
        {
          copy.outputLines.map((line) => (
            <div>
              <dt>{line.k}</dt>
              <dd>{line.v}</dd>
            </div>
          ))
        }
      </dl>
      <div class="hero__verdict"><span class="dot"></span>{copy.verdict}</div>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: var(--space-12); background: var(--white); overflow: hidden; }
  .hero__text { text-align: center; }
  .hero__title {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: clamp(2.5rem, 1.4rem + 4.6vw, var(--text-5xl));
    line-height: 1.06;
    letter-spacing: var(--tracking-tighter);
    color: var(--text-strong);
  }
  .hero__title span { display: block; }
  .hero__accent { color: var(--brand); }
  :global(:lang(ko)) .hero__title { letter-spacing: -0.02em; line-height: 1.18; }
  .hero__sub {
    max-width: 640px;
    margin: var(--space-7) auto 0;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }
  .hero__ctas { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; margin-top: var(--space-9); }

  .hero__stage { position: relative; margin-top: var(--space-12); padding-bottom: var(--space-13); }
  .hero__grid { position: absolute; z-index: 0; border-radius: 2px; }
  .hero__grid--a { left: 0; top: 64px; width: 38%; height: 72%; }
  .hero__grid--b { right: 0; top: 0; width: 30%; height: 58%; }

  .hero__code { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; }
  @media (min-width: 1101px) { .hero__code { transform: translateX(-100px); } }
  .hero__output {
    position: absolute; z-index: 2;
    right: max(var(--gutter), calc(50% - 560px));
    bottom: var(--space-8);
    width: 300px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-6);
  }
  .hero__output-head { display: flex; align-items: center; gap: 8px; font: var(--type-ui); color: var(--text-strong); margin-bottom: var(--space-5); }
  .hero__output dl { margin: 0; display: grid; gap: var(--space-4); }
  .hero__output dt { font: var(--fw-regular) var(--text-xs) / 1.3 var(--font-sans); color: var(--text-muted); }
  .hero__output dd { margin: 2px 0 0; font: var(--fw-medium) var(--text-sm) / 1.4 var(--font-mono); color: var(--text-strong); }
  .hero__verdict {
    display: inline-flex; align-items: center; gap: 6px;
    margin-top: var(--space-5);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--success-subtle);
    color: var(--success);
    font: var(--fw-medium) var(--text-xs) / 1.4 var(--font-mono);
  }
  .hero__verdict .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  @media (max-width: 1100px) {
    .hero__output { position: relative; right: auto; bottom: auto; width: auto; max-width: 720px; margin: var(--space-6) auto 0; }
  }
  @media (max-width: 640px) {
    .hero__stage { padding-bottom: var(--space-11); }
    .hero__grid--a { width: 60%; top: 40px; }
    .hero__grid--b { width: 50%; }
  }
</style>
