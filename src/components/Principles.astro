---
import { t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const copy = t(Astro.props.locale).principles;
---

<section class="section principles">
  <div class="container">
    <div class="frame">
      <div class="frame__grid graph" aria-hidden="true"></div>
      <div class="frame__body">
        <div class="section-head">
          <span class="eyebrow">{copy.eyebrow}</span>
          <h2 class="section-title">{copy.title}</h2>
        </div>
        <ol class="list">
          {
            copy.items.map((item, i) => (
              <li>
                <span class="list__n">{String(i + 1).padStart(2, "0")}</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .principles { padding-top: 0; }
  .frame { position: relative; padding: var(--space-11) 0 0 var(--space-11); }
  .frame__grid { position: absolute; left: 0; top: 0; width: 55%; height: 70%; }
  .frame__body {
    position: relative;
    background: var(--white);
    border: 1px solid var(--border);
    padding: var(--space-12) var(--space-11);
  }
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-9); }
  .list__n { font: var(--fw-medium) var(--text-sm) / 1 var(--font-mono); color: var(--accent-strong); }
  .list h3 { margin-top: var(--space-5); font: var(--type-h3); font-family: var(--font-display); color: var(--text-strong); }
  .list p { margin: var(--space-4) 0 0; font-size: var(--text-base); line-height: var(--leading-normal); color: var(--text-muted); }

  @media (max-width: 900px) {
    .frame { padding: var(--space-8) 0 0 var(--space-8); }
    .frame__body { padding: var(--space-10) var(--space-7); }
    .list { grid-template-columns: 1fr; gap: var(--space-8); }
  }
  @media (max-width: 640px) {
    .frame { padding: var(--space-6) 0 0 var(--space-6); }
    .frame__body { padding: var(--space-9) var(--space-5); }
  }
</style>
